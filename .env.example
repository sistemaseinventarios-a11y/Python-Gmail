GMAIL_USER=facturaelectronica@disico.com.co
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Carpeta de Drive sincronizada localmente donde se crean las subcarpetas por día
# con los ZIP/PDF de cada factura.
CARPETA_DRIVE_LOCAL=G:\Mi unidad\Facturas Houston

# Ruta completa del Excel de control (puede estar en otra carpeta de Drive).
RUTA_EXCEL_CONTROL=G:\Mi unidad\Consolidado 2026.xlsx

# Opcional: ruta del Excel de casos pendientes de revisión manual.
# Si se omite, se crea como "Pendientes_de_revision.xlsx" dentro de CARPETA_DRIVE_LOCAL.
# RUTA_COLA_REVISION=G:\Mi unidad\Facturas Houston\Pendientes_de_revision.xlsx

# Opcional: en la primera corrida (sin historial previo), cuántas horas hacia
# atrás revisar. Las corridas siguientes continúan automáticamente desde la
# última vez que corrió el script.
# VENTANA_INICIAL_HORAS=24
